{
  "name": "job-application-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --test \"tests/**/*.test.ts\"",
    "test:discovery": "node --conditions=react-server --test \"tests/discovery/*.test.ts\"",
    "test:evaluation": "node --conditions=react-server --test \"tests/evaluation/*.test.ts\"",
    "test:chatgpt": "node --conditions=react-server --test \"tests/chatgpt/*.test.ts\"",
    "test:profile": "node --conditions=react-server --test \"tests/profile/*.test.ts\"",
    "test:database": "node --conditions=react-server --test \"tests/database/*.test.ts\"",
    "db:migrate": "node --conditions=react-server scripts/migrate.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "jose": "6.2.13",
    "next": "16.4.2",
    "openai": "7.41.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "typescript": "5.9.3"
  }
}
